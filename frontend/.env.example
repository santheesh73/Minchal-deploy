# MINCHAL Frontend Environment Configuration
#
# Copy this file to `.env` — it is gitignored, so EACH developer needs their
# own. Without it, both defaults apply: mocks ON, and the API base URL points
# at http://localhost:8080, which is YOUR laptop, where no backend runs.

# false = talk to the real backend. Anything else (including omitting it)
# leaves mocks on.
VITE_USE_MOCKS=false

# The backend tunnel. Quick Cloudflare tunnels EXPIRE WITHOUT WARNING and the
# URL changes on every restart — if requests suddenly fail, ask for the current
# one before debugging your own code. Confirm with:
#   curl https://crown-greg-all-governor.trycloudflare.com/health
#   -> {"ok":true,"version":"engine-1"}
VITE_API_BASE_URL=https://crown-greg-all-governor.trycloudflare.com

# For local backend work instead (uvicorn main:app --port 8080):
# VITE_API_BASE_URL=http://localhost:8080

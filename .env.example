# MINCHAL — Environment Configuration Template
# Copy relevant keys to backend/.env or frontend/.env

# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------
# Server-side Gemini API key (DO NOT EXPOSE TO FRONTEND)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model (optional, defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Demo safety net mode (set to true only for offline fallback demos)
DEMO_MODE=false

# Port for FastAPI uvicorn server (default: 8080)
PORT=8080


# FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------
# Base URL for MINCHAL FastAPI backend
VITE_API_BASE_URL=http://localhost:8080

# Set to true for offline mock mode development; false for live backend API calls
VITE_USE_MOCKS=false

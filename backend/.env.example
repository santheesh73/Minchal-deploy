GEMINI_API_KEY=
# Optional. Primary Gemini model. Defaults to gemini-3.1-flash-lite.
# On 429 (no quota) or 404 (model retired) the client falls back through
# gemini-3.6-flash then gemini-flash-latest, and logs which model served.
# An override set here is PREPENDED to that list, not a replacement, so a bad
# value degrades to a known-good model instead of taking extraction down.
GEMINI_MODEL=

# Demo safety net. Leave OFF by default; turn on just before demoing.
# See backend/demo_cache.py for what it serves and the SWAP PROCEDURE.
DEMO_MODE=false
